  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #f7f7f7; /* 设置主窗口的背景色 */
}

QWidget {
    background-color: #f7f7f7; /* 设置页面背景色 */
    font-family: &quot;Microsoft YaHei&quot;;
    font-size: 14px;
    color: #333333;
}


QLineEdit {
    border: 1px solid #cccccc; /* 边框颜色 */
    border-radius: 5px; /* 圆角 */
    background-color: #ffffff; /* 可编辑时的背景颜色 */
    color: #333333; /* 字体颜色 */
}

QLineEdit[readOnly=&quot;true&quot;] {
    background-color: #f0f0f0; /* 只读状态下的背景颜色 */
    color: #666666; /* 只读状态下的字体颜色 */
    border: 1px solid #aaaaaa; /* 只读状态下的边框颜色 */
}

QComboBox {
    border: 1px solid #cccccc;
    border-radius: 5px;
    background-color: #ffffff;
    padding: 5px;
}

QComboBox::drop-down {
    border-left: 1px solid #cccccc;
    width: 30px;
}

QComboBox::down-arrow {
    image: url(:/icons/images/arrow_down.png);
}
QLabel {
    font-size: 15px;
    color: #555555;
    text-align: center;
}
QStatusBar {
    background-color: #eeeeee;
    border-top: 1px solid #cccccc;
}
</string>
