                 </property>
                 <property name="styleSheet">
                  <string notr="true">QComboBox {
    border: 1px solid #cccccc; /* 边框 */
    border-radius: 5px;
    background-color: #ffffff;
}
QComboBox::drop-down {
    border-left: 1px solid #cccccc; /* 下拉按钮的边框 */
    width: 30px;
}
QComboBox::down-arrow {
    image: url(:/icons/images/arrow_down.png); /* 您可以替换为您自己的下拉箭头图标 */
}
</string>
